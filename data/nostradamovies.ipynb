            "def num_faces_dlib(image):\n",
            "    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)\n",
            "    detector = dlib.get_frontal_face_detector()\n",
            "    faces = detector(gray)\n",
            "\n",
            "    return len(faces)"
