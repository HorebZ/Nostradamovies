            "def has_face_dlib(image):\n",
            "    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)\n",
            "    detector = dlib.get_frontal_face_detector()\n",
            "    faces = detector(gray)\n",
            "\n",
            "    return len(faces) > 0\n"
         ]
      },
      {
         "cell_type": "code",
         "execution_count": 14,
         "metadata": {},
         "outputs": [],
         "source": [
            "def num_faces_dlib(image):\n",
            "    gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)\n",
            "    detector = dlib.get_frontal_face_detector()\n",
            "    faces = detector(gray)\n",
            "\n",
            "    return len(faces)"
         ]
      },
      {
         "cell_type": "code",
         "execution_count": 15,
         "metadata": {},
         "outputs": [],
         "source": [
            "def has_face_center(image):\n",
            "    height, width, _ = image.shape\n",
            "    center = image[height//4:3*height//4, width//4:3*width//4]\n",
            "    faces = has_face_dlib(center)\n",
            "\n",
            "    return faces"
         ]
      },
      {
         "attachments": {},
         "cell_type": "markdown",
         "metadata": {},
         "source": [
            "#### Text"
