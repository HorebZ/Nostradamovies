         "metadata": {},
         "outputs": [],
         "source": [
            "def has_text_top_quarter(image):\n",
            "    height, _, _ = image.shape\n",
            "    top_quarter = image[:height//4, :]\n",
            "    text = image_to_string(top_quarter)\n",
            "\n",
            "    return 0 if text.strip() == \"\" else 1"
         ]
      },
      {
         "cell_type": "code",
         "execution_count": 17,
         "metadata": {},
         "outputs": [],
         "source": [
            "def has_text_bottom_half(image):\n",
            "    height, _, _ = image.shape\n",
            "    bottom_half = image[height//2:, :]\n",
            "    text = image_to_string(bottom_half)\n",
            "\n",
            "    return 0 if text.strip() == \"\" else 1"
         ]
      },
      {
         "cell_type": "code",
         "execution_count": 18,
         "metadata": {},
         "outputs": [],
         "source": [
            "def num_text_lines_bottom_quarter(image):\n",
            "    height, _, _ = image.shape\n",
            "    bottom_quarter = image[3*height//4:, :]\n",
            "    text = image_to_string(bottom_quarter)\n",
            "    lines = text.split(\"\\n\")\n",
            "\n",
            "    return len(lines)"
         ]
      },
      {
         "cell_type": "code",
         "execution_count": 19,
         "metadata": {},
         "outputs": [],
         "source": [
            "from pytesseract import pytesseract, Output\n",
            "\n",
            "def largest_text_percentage(image):\n",
            "    d = pytesseract.image_to_data(image, output_type=Output.DICT)\n",
            "    n_boxes = len(d['level'])\n",
            "    max_area = 0\n",
            "\n",
            "    for i in range(n_boxes):\n",
            "        (x, y, w, h) = (d['left'][i], d['top'][i], d['width'][i], d['height'][i])\n",
            "        max_area = max(max_area, w * h)\n",
            "\n",
            "    # return as percentage\n",
            "    return (max_area * 100) / (image.shape[0] * image.shape[1])"
         ]
      },
      {
         "cell_type": "code",
         "execution_count": 20,
         "metadata": {},
         "outputs": [],
         "source": [
            "def is_text_in_bottom_quarter(image):\n",
            "    d = pytesseract.image_to_data(image, output_type=Output.DICT)\n",
            "    n_boxes = len(d['level'])\n",
            "\n",
            "    for i in range(n_boxes):\n",
            "        (x, y, w, h) = (d['left'][i], d['top'][i], d['width'][i], d['height'][i])\n",
            "\n",
            "        # If the center of the bounding box is in the bottom quarter\n",
            "        if y + h/2 > image.shape[0] * 0.75:\n",
            "            return 1\n",
            "\n",
            "    return 0"
         ]
      },
      {
